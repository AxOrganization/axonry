{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "read",
    "substantive",
    "conduct",
    "original",
    "message"
  ],
  "properties": {
    "read": {
      "type": "boolean",
      "description": "true when you read every file of the workspace (another way after a tool failed counts); false only if a file stayed unread"
    },
    "substantive": {
      "$ref": "#/$defs/check"
    },
    "conduct": {
      "$ref": "#/$defs/check"
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "reason",
        "copies"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "copies": {
          "type": [
            "string",
            "null"
          ],
          "description": "the earlier/ directory it copies, if it fails"
        }
      }
    },
    "message": {
      "type": "string"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "reason"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
